<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= site.settings.siteName %></title>
  <meta name="description" content="Studio psicologico della Dott.ssa Licia Taurino. Supporto psicologico, BES, DSA, età evolutiva, adulti, famiglie e stimolazione cognitiva.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@600;700;800&family=Montserrat:wght@300;400;500;600;700;800;900&family=Lora:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    :root{
      --primary:<%= site.settings.primaryColor %>;
      --secondary:<%= site.settings.secondaryColor %>;
      --accent:<%= site.settings.accentColor %>;
      --bg:<%= site.settings.backgroundColor %>;
      --card:<%= site.settings.cardColor || '#FFFFFF' %>;
      --text:<%= site.settings.textColor %>;
      --muted:<%= site.settings.mutedColor || '#60706B' %>;
      --font:'<%= site.settings.fontFamily %>', Inter, sans-serif;
      --heading:'<%= site.settings.headingFont || site.settings.fontFamily %>', serif;
      --title-size:<%= site.settings.titleSize %>px;
      --section-title-size:<%= site.settings.sectionTitleSize || 42 %>px;
      --text-size:<%= site.settings.textSize %>px;
      --menu-size:<%= site.settings.menuSize || 15 %>px;
      --radius:<%= site.settings.radius %>px;
      --container:<%= site.settings.containerWidth || 1180 %>px;
      --section-space:<%= site.settings.sectionSpacing || 88 %>px;
      --align:<%= site.settings.alignment %>;
      --button-radius:<%= site.settings.buttonRadius || 999 %>px;
    }
  </style>
</head>
<body class="<%= preview ? 'preview-mode' : '' %>">
  <% const waLink = "https://wa.me/" + site.settings.whatsapp + "?text=" + encodeURIComponent(site.settings.whatsappMessage || "Buongiorno Dott.ssa Taurino, vorrei ricevere informazioni per prenotare un primo colloquio."); %>
  <% function visualStyle(path){ const s=(site.visualStyles && site.visualStyles[path]) || {}; return Object.entries(s).map(([k,v]) => v !== undefined && v !== '' ? `${k.replace(/[A-Z]/g,m=>'-'+m.toLowerCase())}:${v}` : '').join(';'); } %>
  <% function editAttrs(type,path){ return `data-edit-type="${type}" data-edit-path="${path}" style="${visualStyle(path)}"`; } %>
  <% const waLink = "https://wa.me/" + site.settings.whatsapp + "?text=" + encodeURIComponent(site.settings.whatsappMessage || "Buongiorno Dott.ssa Taurino, vorrei ricevere informazioni per prenotare un primo colloquio."); %>
  <header class="hero" id="home">
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>

    <nav class="nav glass menu-<%= site.settings.menuPosition || 'center' %>">
      <a class="brand" href="#home">
        <span class="brand-logo" data-edit-type="text" data-edit-path="settings.logoText"><%= site.settings.logoText %></span>
        <span>
          <small data-edit-type="text" data-edit-path="settings.profession"><%= site.settings.profession || 'Psicologa' %></small>
          <strong data-edit-type="text" data-edit-path="settings.siteName"><%= site.settings.siteName %></strong>
        </span>
      </a>

      <button class="menu-toggle" type="button" onclick="document.body.classList.toggle('menu-open')" aria-label="Apri menu">☰ Menu</button>

      <div class="nav-links dropdown-menu">
        <% site.nav.filter(n => n.visible !== false).forEach(function(item){ %>
          <a href="<%= item.href %>" onclick="document.body.classList.remove('menu-open')" <%- editAttrs("text","nav."+site.nav.indexOf(item)+".label") %>><%= item.label %></a>
        <% }) %>
      </div>

      <a class="btn small nav-cta" href="<%= waLink %>" target="_blank" rel="noopener" <%- editAttrs("text","hero.primaryButton") %>>Prenota</a>
    </nav>

    <% if(site.hero.visible){ %>
    <section class="hero-grid container editable-align hero-layout-<%= site.hero.layout || 'text-left' %>">
      <div class="hero-copy reveal">
        <p class="eyebrow" data-edit-type="text" data-edit-path="hero.eyebrow"><%= site.hero.eyebrow %></p>
        <h1 data-edit-type="text" data-edit-path="hero.title"><%= site.hero.title %></h1>
        <p class="lead" data-edit-type="text" data-edit-path="hero.subtitle"><%= site.hero.subtitle %></p>
        <div class="actions">
          <a class="btn" href="<%= waLink %>" target="_blank" rel="noopener">💬 <span <%- editAttrs("text","hero.primaryButton") %>><%= site.hero.primaryButton %></span></a>
          <a class="btn ghost" href="#servizi"><span <%- editAttrs("text","hero.secondaryButton") %>><%= site.hero.secondaryButton %></span> →</a>
        </div>
      </div>

      <div class="hero-card reveal delay">
        <% if(site.hero.image){ %>
          <img data-edit-type="image" data-edit-path="hero.image" src="<%= site.hero.image %>" alt="<%= site.settings.siteName %>" style="object-position:<%= site.hero.imagePosition || 'center top' %>">
        <% } else { %>
          <div class="portrait-placeholder">ψ</div>
        <% } %>
        <div class="floating-card top"><span <%- editAttrs("text","hero.badgeTop") %>><%= site.hero.badgeTop || 'Studio Psicologico' %></span></div>
        <div class="floating-card bottom"><span <%- editAttrs("text","hero.badgeBottom") %>><%= site.hero.badgeBottom || 'Ascolto · Cura · Crescita' %></span></div>
      </div>
    </section>
    <% } %>
  </header>


  <% function renderParents(){ %>
    <% if(site.parents && site.parents.visible){ %>
    <section class="section container parents-section" id="genitori">
      <div class="parents-layout">
        <div class="parents-intro">
          <p class="eyebrow"><%= site.parents.eyebrow %></p>
          <h2><%= site.parents.title %></h2>
          <p class="lead"><%= site.parents.text %></p>
          <div class="parents-cta">
            <h3><%= site.parents.ctaTitle %></h3>
            <p><%= site.parents.ctaText %></p>
            <a class="btn" href="<%= waLink %>" target="_blank" rel="noopener"><%= site.parents.ctaButton %></a>
          </div>
        </div>
        <div class="parents-cards">
          <% site.parents.items.forEach(function(item){ %>
          <article class="parent-card">
            <span>✓</span>
            <h3 data-edit-type="text" data-edit-path="cognitive.items.<%= site.cognitive.items.indexOf(item) %>.title"><%= item.title %></h3>
            <p data-edit-type="text" data-edit-path="cognitive.items.<%= site.cognitive.items.indexOf(item) %>.text"><%= item.text %></p>
          </article>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>
  <% } %>

  <% function renderServices(){ %>
    <% if(site.services.visible){ %>
    <section class="section container" id="servizi" <%- editAttrs("section","services") %>>
      <div class="section-head">
        <p class="eyebrow" data-edit-type="text" data-edit-path="services.eyebrow"><%= site.services.eyebrow %></p>
        <h2 data-edit-type="text" data-edit-path="services.title"><%= site.services.title %></h2>
        <% if(site.services.text){ %><p class="lead narrow" data-edit-type="text" data-edit-path="services.text"><%= site.services.text %></p><% } %>
      </div>
      <div class="cards <%= site.services.layout === 'grid-3' ? 'three' : 'four' %>">
        <% site.services.items.forEach(function(s){ %>
        <article class="card">
          <span class="icon">✦</span>
          <h3 data-edit-type="text" data-edit-path="services.items.<%= site.services.items.indexOf(s) %>.title"><%= s.title %></h3>
          <p data-edit-type="text" data-edit-path="services.items.<%= site.services.items.indexOf(s) %>.text"><%= s.text %></p>
        </article>
        <% }) %>
      </div>
    </section>
    <% } %>
  <% } %>

  <% function renderBes(){ %>
    <% if(site.bes.visible){ %>
    <section class="section dark" id="bes" <%- editAttrs("section","bes") %>>
      <div class="container split">
        <div>
          <p class="eyebrow" data-edit-type="text" data-edit-path="bes.eyebrow"><%= site.bes.eyebrow %></p>
          <h2 data-edit-type="text" data-edit-path="bes.title"><%= site.bes.title %></h2>
          <p class="lead" data-edit-type="text" data-edit-path="bes.text"><%= site.bes.text %></p>
        </div>
        <div class="chips">
          <% site.bes.items.forEach(function(item){ %><span>✓ <%= item %></span><% }) %>
        </div>
      </div>
    </section>
    <% } %>
  <% } %>

  <% function renderCognitive(){ %>
    <% if(site.cognitive && site.cognitive.visible){ %>
    <section class="section container cognitive-section" id="stimolazione" <%- editAttrs("section","cognitive") %>>
      <div class="section-head">
        <p class="eyebrow" data-edit-type="text" data-edit-path="cognitive.eyebrow"><%= site.cognitive.eyebrow %></p>
        <h2 data-edit-type="text" data-edit-path="cognitive.title"><%= site.cognitive.title %></h2>
        <p class="lead narrow" data-edit-type="text" data-edit-path="cognitive.text"><%= site.cognitive.text %></p>
      </div>
      <div class="cards three neuro-cards">
        <% site.cognitive.items.forEach(function(item){ %>
        <article class="card neuro-card">
          <span class="icon">🧠</span>
          <h3 data-edit-type="text" data-edit-path="cognitive.items.<%= site.cognitive.items.indexOf(item) %>.title"><%= item.title %></h3>
          <p data-edit-type="text" data-edit-path="cognitive.items.<%= site.cognitive.items.indexOf(item) %>.text"><%= item.text %></p>
        </article>
        <% }) %>
      </div>
    </section>
    <% } %>
  <% } %>

  <% function renderAbout(){ %>
    <% if(site.about.visible){ %>
    <section <%- editAttrs("section","about") %> class="section container split about-section about-layout-<%= site.about.layout || 'photo-left' %>" id="chi-sono">
      <div class="about-profile-card">
        <% if(site.about.image){ %>
          <img data-edit-type="image" data-edit-path="about.image" src="<%= site.about.image %>" alt="<%= site.about.name || 'Licia Taurino' %>" style="object-position:<%= site.about.imagePosition || 'center top' %>">
        <% } else { %>
          <div class="portrait-placeholder small">LT</div>
        <% } %>
        <div class="about-profile-text">
          <h3 data-edit-type="text" data-edit-path="about.name"><%= site.about.name || 'LICIA TAURINO' %></h3>
          <% if(site.about.subtitle){ %><p data-edit-type="text" data-edit-path="about.subtitle"><%= site.about.subtitle %></p><% } %>
          <p data-edit-type="text" data-edit-path="about.alboText"><%= site.about.alboText || site.settings.albo %></p>
        </div>
      </div>
      <div class="about-copy">
        <p class="eyebrow" data-edit-type="text" data-edit-path="about.eyebrow"><%= site.about.eyebrow %></p>
        <h2 data-edit-type="text" data-edit-path="about.title"><%= site.about.title %></h2>
        <p class="lead" data-edit-type="text" data-edit-path="about.text"><%= site.about.text %></p>
      </div>
    </section>
    <% } %>
  <% } %>

  <% function renderProcess(){ %>
    <% if(site.process.visible){ %>
    <section class="section container" id="percorso" <%- editAttrs("section","process") %>>
      <div class="process-box">
        <div>
          <p class="eyebrow" data-edit-type="text" data-edit-path="process.eyebrow"><%= site.process.eyebrow %></p>
          <h2 data-edit-type="text" data-edit-path="process.title"><%= site.process.title %></h2>
          <p data-edit-type="text" data-edit-path="process.text"><%= site.process.text %></p>
        </div>
        <div class="steps">
          <% site.process.items.forEach(function(step, i){ %>
            <div class="step"><b><%= i + 1 %></b><span><%= step %></span></div>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>
  <% } %>

  <% function renderArticles(){ %>
    <% if(site.articles.visible){ %>
    <section class="section container" id="articoli">
      <div class="section-head">
        <p class="eyebrow"><%= site.articles.eyebrow %></p>
        <h2><%= site.articles.title %></h2>
        <p class="lead narrow"><%= site.articles.text %></p>
      </div>
      <div class="cards three">
        <% site.articles.items.forEach(function(a){ %>
        <article class="card article">
          <h3><%= a.title %></h3>
          <p><%= a.text %></p>
          <a href="#contatti">Richiedi informazioni →</a>
        </article>
        <% }) %>
      </div>
    </section>
    <% } %>
  <% } %>


  <% function renderBootcamps(){ %>
    <% if(site.bootcamps && site.bootcamps.visible){ %>
    <section class="section container bootcamp-section" id="bootcamp">
      <div class="section-head">
        <p class="eyebrow"><%= site.bootcamps.eyebrow %></p>
        <h2><%= site.bootcamps.title %></h2>
        <p class="lead narrow"><%= site.bootcamps.text %></p>
      </div>
      <div class="bootcamp-grid">
        <% site.bootcamps.items.forEach(function(item){ %>
        <article class="bootcamp-card">
          <div class="poster-box">
            <% if(item.image){ %>
              <img src="<%= item.image %>" alt="<%= item.title %>">
            <% } else { %>
              <div class="poster-placeholder">
                <span>Locandina</span>
                <b><%= item.period %></b>
              </div>
            <% } %>
          </div>
          <div class="bootcamp-info">
            <small><%= item.period %></small>
            <h3 data-edit-type="text" data-edit-path="cognitive.items.<%= site.cognitive.items.indexOf(item) %>.title"><%= item.title %></h3>
            <p data-edit-type="text" data-edit-path="cognitive.items.<%= site.cognitive.items.indexOf(item) %>.text"><%= item.text %></p>
            <a href="<%= waLink %>" target="_blank" rel="noopener">Richiedi informazioni →</a>
          </div>
        </article>
        <% }) %>
      </div>
    </section>
    <% } %>
  <% } %>

  <% function renderContact(){ %>
    <% if(site.contact.visible){ %>
    <section class="section contact" id="contatti" <%- editAttrs("section","contact") %>>
      <div class="container">
        <div class="section-head">
          <p class="eyebrow" data-edit-type="text" data-edit-path="contact.eyebrow"><%= site.contact.eyebrow %></p>
          <h2 data-edit-type="text" data-edit-path="contact.title"><%= site.contact.title %></h2>
          <p class="lead narrow" data-edit-type="text" data-edit-path="contact.text"><%= site.contact.text %></p>
        </div>
        <div class="contact-grid contact-grid-original-icons" <%- editAttrs("section","contact") %>>
          <a href="tel:<%= site.settings.phone.replace(/\s/g,'') %>" class="contact-card" <%- editAttrs("box","settings.phone") %>>
            <span class="contact-logo phone-logo">☎</span>
            <b <%- editAttrs("text","labels.phone") %>><%= site.labels?.phone || "Telefono" %></b>
            <span <%- editAttrs("text","settings.phone") %>><%= site.settings.phone %></span>
          </a>
          <a href="<%= waLink %>" target="_blank" rel="noopener" class="contact-card" <%- editAttrs("box","settings.whatsapp") %>>
            <span class="contact-logo whatsapp-logo">💬</span>
            <b <%- editAttrs("text","labels.whatsapp") %>><%= site.labels?.whatsapp || "WhatsApp" %></b>
            <span <%- editAttrs("text","settings.phone") %>><%= site.settings.phone %></span>
          </a>
          <a href="<%= site.settings.instagramUrl %>" target="_blank" rel="noopener" class="contact-card" <%- editAttrs("box","settings.instagram") %>>
            <span class="contact-logo instagram-logo">◎</span>
            <b <%- editAttrs("text","labels.instagram") %>><%= site.labels?.instagram || "Instagram" %></b>
            <span <%- editAttrs("text","settings.instagram") %>>@<%= site.settings.instagram %></span>
          </a>
          <a href="mailto:<%= site.settings.email %>" class="contact-card" <%- editAttrs("box","settings.email") %>>
            <span class="contact-logo email-logo">✉</span>
            <b <%- editAttrs("text","labels.email") %>><%= site.labels?.email || "Email" %></b>
            <span <%- editAttrs("text","settings.email") %>><%= site.settings.email %></span>
          </a>
          <div class="contact-card" <%- editAttrs("box","settings.address") %>>
            <span class="contact-logo studio-logo">⌂</span>
            <b <%- editAttrs("text","labels.studio") %>><%= site.labels?.studio || "Studio" %></b>
            <span <%- editAttrs("text","settings.address") %>><%= site.settings.address %><br><%= site.settings.city %></span>
          </div>
        </div>
      </div>
    </section>
    <% } %>
  <% } %>

  <% (site.sectionOrder || ['services','bes','cognitive','about','process','articles','contact']).forEach(function(section){ %>
    <% if(section === 'parents'){ renderParents(); } %>
    <% if(section === 'services'){ renderServices(); } %>
    <% if(section === 'bes'){ renderBes(); } %>
    <% if(section === 'cognitive'){ renderCognitive(); } %>
    <% if(section === 'about'){ renderAbout(); } %>
    <% if(section === 'bootcamps'){ renderBootcamps(); } %>
    <% if(section === 'process'){ renderProcess(); } %>
    <% if(section === 'articles'){ renderArticles(); } %>
    <% if(section === 'contact'){ renderContact(); } %>
  <% }) %>

  <footer <%- editAttrs("section","footer") %>>
    <div class="container footer-grid">
      <p><span <%- editAttrs("text","settings.footerCopyright") %>>© 2026 <%= site.settings.siteName %>. Tutti i diritti riservati.</span></p>
      <p><span <%- editAttrs("text","settings.albo") %>><%= site.settings.albo %></span> · <span <%- editAttrs("text","settings.piva") %>><%= site.settings.piva %></span> · <a href="<%= site.settings.instagramUrl %>" target="_blank" rel="noopener">@<%= site.settings.instagram %></a> · <span <%- editAttrs("text","settings.footerText") %>><%= site.settings.footerText %></span></p>
    </div>
  </footer>
</body>
</html>
