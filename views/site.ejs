<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= site.settings.siteName %></title>
  <meta name="description" content="Studio psicologico della Dott.ssa Licia Taurino. Supporto psicologico, BES, DSA, età evolutiva, adulti, famiglie e stimolazione cognitiva.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@600;700;800&family=Montserrat:wght@300;400;500;600;700;800;900&family=Lora:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    :root{
      --primary:<%= site.settings.primaryColor %>;
      --secondary:<%= site.settings.secondaryColor %>;
      --accent:<%= site.settings.accentColor %>;
      --bg:<%= site.settings.backgroundColor %>;
      --card:<%= site.settings.cardColor || '#FFFFFF' %>;
      --text:<%= site.settings.textColor %>;
      --muted:<%= site.settings.mutedColor || '#60706B' %>;
      --font:'<%= site.settings.fontFamily %>', Inter, sans-serif;
      --heading:'<%= site.settings.headingFont || site.settings.fontFamily %>', serif;
      --title-size:<%= site.settings.titleSize %>px;
      --section-title-size:<%= site.settings.sectionTitleSize || 42 %>px;
      --text-size:<%= site.settings.textSize %>px;
      --menu-size:<%= site.settings.menuSize || 15 %>px;
      --radius:<%= site.settings.radius %>px;
      --container:<%= site.settings.containerWidth || 1180 %>px;
      --section-space:<%= site.settings.sectionSpacing || 88 %>px;
      --align:<%= site.settings.alignment %>;
      --button-radius:<%= site.settings.buttonRadius || 999 %>px;
    }
  </style>
</head>
<% 
function styleAttr(key){
  const s = (site.styles && site.styles[key]) || {};
  let out = '';
  if(s.color) out += 'color:' + s.color + ';';
  if(s.background) out += 'background:' + s.background + ';';
  if(s.fontSize) out += 'font-size:' + s.fontSize + 'px;';
  if(s.bold) out += 'font-weight:900;';
  if(s.align) out += 'text-align:' + s.align + ';';
  if(s.width) out += 'width:' + s.width + '%;';
  if(s.height) out += 'height:' + s.height + 'px;';
  if(s.paddingTop) out += 'padding-top:' + s.paddingTop + 'px;';
  if(s.paddingBottom) out += 'padding-bottom:' + s.paddingBottom + 'px;';
  if(s.radius) out += 'border-radius:' + s.radius + 'px;';
  if(s.objectPosition) out += 'object-position:' + s.objectPosition + ';';
  return out;
}
const waLink = "https://wa.me/" + site.settings.whatsapp + "?text=" + encodeURIComponent(site.settings.whatsappMessage || "Buongiorno Dott.ssa Taurino, vorrei ricevere informazioni per prenotare un primo colloquio.");
%>
<body class="<%= preview ? 'preview-mode' : '' %>">
  <header class="hero" id="home" style="<%= styleAttr('hero.section') %>">
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>

    <nav class="nav glass menu-<%= site.settings.menuPosition || 'center' %>" style="<%= styleAttr('menu.bar') %>">
      <a class="brand" href="#home">
        <span class="brand-logo" style="<%= styleAttr('menu.logo') %>"><%= site.settings.logoText %></span>
        <span>
          <small style="<%= styleAttr('menu.profession') %>"><%= site.settings.profession || 'Psicologa' %></small>
          <strong style="<%= styleAttr('menu.siteName') %>"><%= site.settings.siteName %></strong>
        </span>
      </a>
      <button class="menu-toggle" type="button" onclick="document.body.classList.toggle('menu-open')" aria-label="Apri menu">☰ Menu</button>
      <div class="nav-links dropdown-menu">
        <% site.nav.filter(n => n.visible !== false).forEach(function(item, i){ %>
          <a href="<%= item.href %>" onclick="document.body.classList.remove('menu-open')" style="<%= styleAttr('nav.'+i) %>"><%= item.label %></a>
        <% }) %>
      </div>
      <a class="btn small nav-cta" href="<%= waLink %>" target="_blank" rel="noopener" style="<%= styleAttr('menu.button') %>">Prenota</a>
    </nav>

    <% if(site.hero.visible){ %>
    <section class="hero-grid container editable-align hero-layout-<%= site.hero.layout || 'text-left' %>">
      <div class="hero-copy reveal">
        <p class="eyebrow" style="<%= styleAttr('hero.eyebrow') %>"><%= site.hero.eyebrow %></p>
        <h1 style="<%= styleAttr('hero.title') %>"><%= site.hero.title %></h1>
        <p class="lead" style="<%= styleAttr('hero.subtitle') %>"><%= site.hero.subtitle %></p>
        <div class="actions">
          <a class="btn" href="<%= waLink %>" target="_blank" rel="noopener" style="<%= styleAttr('hero.primaryButton') %>">💬 <%= site.hero.primaryButton %></a>
          <a class="btn ghost" href="#servizi" style="<%= styleAttr('hero.secondaryButton') %>"><%= site.hero.secondaryButton %> →</a>
        </div>
      </div>
      <div class="hero-card reveal delay" style="<%= styleAttr('hero.imageCard') %>">
        <% if(site.hero.image){ %>
          <img src="<%= site.hero.image %>" alt="<%= site.settings.siteName %>" style="object-position:<%= site.hero.imagePosition || 'center top' %>;<%= styleAttr('hero.image') %>">
        <% } else { %><div class="portrait-placeholder">ψ</div><% } %>
        <div class="floating-card top" style="<%= styleAttr('hero.badgeTop') %>"><%= site.hero.badgeTop || 'Studio Psicologico' %></div>
        <div class="floating-card bottom" style="<%= styleAttr('hero.badgeBottom') %>"><%= site.hero.badgeBottom || 'Ascolto · Cura · Crescita' %></div>
      </div>
    </section>
    <% } %>
  </header>

  <% function renderServices(){ %>
    <% if(site.services.visible){ %>
    <section class="section container" id="servizi" style="<%= styleAttr('services.section') %>">
      <div class="section-head">
        <p class="eyebrow" style="<%= styleAttr('services.eyebrow') %>"><%= site.services.eyebrow %></p>
        <h2 style="<%= styleAttr('services.title') %>"><%= site.services.title %></h2>
        <% if(site.services.text){ %><p class="lead narrow" style="<%= styleAttr('services.text') %>"><%= site.services.text %></p><% } %>
      </div>
      <div class="cards <%= site.services.layout === 'grid-3' ? 'three' : 'four' %>">
        <% site.services.items.forEach(function(s, i){ %>
        <article class="card" style="<%= styleAttr('services.items.'+i+'.card') %>">
          <span class="icon">✦</span>
          <h3 style="<%= styleAttr('services.items.'+i+'.title') %>"><%= s.title %></h3>
          <p style="<%= styleAttr('services.items.'+i+'.text') %>"><%= s.text %></p>
        </article>
        <% }) %>
      </div>
    </section>
    <% } %>
  <% } %>

  <% function renderBes(){ %>
    <% if(site.bes.visible){ %>
    <section class="section dark" id="bes" style="<%= styleAttr('bes.section') %>">
      <div class="container split">
        <div>
          <p class="eyebrow" style="<%= styleAttr('bes.eyebrow') %>"><%= site.bes.eyebrow %></p>
          <h2 style="<%= styleAttr('bes.title') %>"><%= site.bes.title %></h2>
          <p class="lead" style="<%= styleAttr('bes.text') %>"><%= site.bes.text %></p>
        </div>
        <div class="chips">
          <% site.bes.items.forEach(function(item, i){ %><span style="<%= styleAttr('bes.items.'+i) %>">✓ <%= item %></span><% }) %>
        </div>
      </div>
    </section>
    <% } %>
  <% } %>

  <% function renderCognitive(){ %>
    <% if(site.cognitive && site.cognitive.visible){ %>
    <section class="section container cognitive-section" id="stimolazione" style="<%= styleAttr('cognitive.section') %>">
      <div class="section-head">
        <p class="eyebrow" style="<%= styleAttr('cognitive.eyebrow') %>"><%= site.cognitive.eyebrow %></p>
        <h2 style="<%= styleAttr('cognitive.title') %>"><%= site.cognitive.title %></h2>
        <p class="lead narrow" style="<%= styleAttr('cognitive.text') %>"><%= site.cognitive.text %></p>
      </div>
      <div class="cards three neuro-cards">
        <% site.cognitive.items.forEach(function(item, i){ %>
        <article class="card neuro-card" style="<%= styleAttr('cognitive.items.'+i+'.card') %>">
          <span class="icon">🧠</span>
          <h3 style="<%= styleAttr('cognitive.items.'+i+'.title') %>"><%= item.title %></h3>
          <p style="<%= styleAttr('cognitive.items.'+i+'.text') %>"><%= item.text %></p>
        </article>
        <% }) %>
      </div>
    </section>
    <% } %>
  <% } %>

  <% function renderAbout(){ %>
    <% if(site.about.visible){ %>
    <section class="section container split about-section about-layout-<%= site.about.layout || 'photo-left' %>" id="chi-sono" style="<%= styleAttr('about.section') %>">
      <div class="about-profile-card" style="<%= styleAttr('about.imageCard') %>">
        <% if(site.about.image){ %><img src="<%= site.about.image %>" alt="<%= site.about.name || 'Licia Taurino' %>" style="object-position:<%= site.about.imagePosition || 'center top' %>;<%= styleAttr('about.image') %>"><% } else { %><div class="portrait-placeholder small">LT</div><% } %>
        <div class="about-profile-text">
          <h3 style="<%= styleAttr('about.name') %>"><%= site.about.name || 'LICIA TAURINO' %></h3>
          <% if(site.about.subtitle){ %><p style="<%= styleAttr('about.subtitle') %>"><%= site.about.subtitle %></p><% } %>
          <p style="<%= styleAttr('about.alboText') %>"><%= site.about.alboText || site.settings.albo %></p>
        </div>
      </div>
      <div class="about-copy">
        <p class="eyebrow" style="<%= styleAttr('about.eyebrow') %>"><%= site.about.eyebrow %></p>
        <h2 style="<%= styleAttr('about.title') %>"><%= site.about.title %></h2>
        <p class="lead" style="<%= styleAttr('about.text') %>"><%= site.about.text %></p>
      </div>
    </section>
    <% } %>
  <% } %>

  <% function renderProcess(){ %>
    <% if(site.process.visible){ %>
    <section class="section container" id="percorso" style="<%= styleAttr('process.section') %>">
      <div class="process-box" style="<%= styleAttr('process.box') %>">
        <div>
          <p class="eyebrow" style="<%= styleAttr('process.eyebrow') %>"><%= site.process.eyebrow %></p>
          <h2 style="<%= styleAttr('process.title') %>"><%= site.process.title %></h2>
          <p style="<%= styleAttr('process.text') %>"><%= site.process.text %></p>
        </div>
        <div class="steps">
          <% site.process.items.forEach(function(step, i){ %><div class="step" style="<%= styleAttr('process.items.'+i) %>"><b><%= i + 1 %></b><span><%= step %></span></div><% }) %>
        </div>
      </div>
    </section>
    <% } %>
  <% } %>

  <% function renderArticles(){ %>
    <% if(site.articles.visible){ %>
    <section class="section container" id="articoli" style="<%= styleAttr('articles.section') %>">
      <div class="section-head">
        <p class="eyebrow" style="<%= styleAttr('articles.eyebrow') %>"><%= site.articles.eyebrow %></p>
        <h2 style="<%= styleAttr('articles.title') %>"><%= site.articles.title %></h2>
        <p class="lead narrow" style="<%= styleAttr('articles.text') %>"><%= site.articles.text %></p>
      </div>
      <div class="cards three">
        <% site.articles.items.forEach(function(a, i){ %>
        <article class="card article" style="<%= styleAttr('articles.items.'+i+'.card') %>">
          <h3 style="<%= styleAttr('articles.items.'+i+'.title') %>"><%= a.title %></h3>
          <p style="<%= styleAttr('articles.items.'+i+'.text') %>"><%= a.text %></p>
          <a href="#contatti">Richiedi informazioni →</a>
        </article>
        <% }) %>
      </div>
    </section>
    <% } %>
  <% } %>

  <% function renderContact(){ %>
    <% if(site.contact.visible){ %>
    <section class="section contact" id="contatti" style="<%= styleAttr('contact.section') %>">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow" style="<%= styleAttr('contact.eyebrow') %>"><%= site.contact.eyebrow %></p>
          <h2 style="<%= styleAttr('contact.title') %>"><%= site.contact.title %></h2>
          <p class="lead narrow" style="<%= styleAttr('contact.text') %>"><%= site.contact.text %></p>
        </div>
        <div class="contact-grid contact-grid-refined">
          <a href="tel:<%= site.settings.phone.replace(/\s/g,'') %>" class="contact-card" style="<%= styleAttr('contact.phoneCard') %>"><small>Chiamata diretta</small><b>Telefono</b><span><%= site.settings.phone %></span></a>
          <a href="<%= waLink %>" target="_blank" rel="noopener" class="contact-card featured" style="<%= styleAttr('contact.whatsappCard') %>"><small>Messaggio già pronto</small><b>WhatsApp</b><span><%= site.settings.phone %></span></a>
          <a href="<%= site.settings.instagramUrl %>" target="_blank" rel="noopener" class="contact-card" style="<%= styleAttr('contact.instagramCard') %>"><small>Profilo professionale</small><b>Instagram</b><span>@<%= site.settings.instagram %></span></a>
          <a href="mailto:<%= site.settings.email %>" class="contact-card" style="<%= styleAttr('contact.emailCard') %>"><small>Scrivi una email</small><b>Email</b><span><%= site.settings.email %></span></a>
          <div class="contact-card" style="<%= styleAttr('contact.studioCard') %>"><small>Ricevimento</small><b>Studio</b><span><%= site.settings.address %><br><%= site.settings.city %></span></div>
        </div>
      </div>
    </section>
    <% } %>
  <% } %>

  <% (site.sectionOrder || ['services','bes','cognitive','about','process','articles','contact']).forEach(function(section){ %>
    <% if(section === 'services'){ renderServices(); } %>
    <% if(section === 'bes'){ renderBes(); } %>
    <% if(section === 'cognitive'){ renderCognitive(); } %>
    <% if(section === 'about'){ renderAbout(); } %>
    <% if(section === 'process'){ renderProcess(); } %>
    <% if(section === 'articles'){ renderArticles(); } %>
    <% if(section === 'contact'){ renderContact(); } %>
  <% }) %>

  <footer style="<%= styleAttr('footer.section') %>">
    <div class="container footer-grid">
      <p style="<%= styleAttr('footer.left') %>">© 2026 <%= site.settings.siteName %>. Tutti i diritti riservati.</p>
      <p style="<%= styleAttr('footer.right') %>"><%= site.settings.albo %> · <%= site.settings.piva %> · <a href="<%= site.settings.instagramUrl %>" target="_blank" rel="noopener">@<%= site.settings.instagram %></a> · <%= site.settings.footerText %></p>
    </div>
  </footer>
</body>
</html>
