<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin - Psicologa Taurino Licia</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-shell">
    <aside>
      <h1>Admin sito</h1>
      <p>Modifica tutto il sito: testi, colori, font, dimensioni, allineamento e sezioni.</p>
      <a href="/" target="_blank">Apri sito</a>
      <form method="post" action="/admin/logout"><button class="secondary">Esci</button></form>
    </aside>
    <main>
      <% if(saved){ %><div class="saved">Modifiche salvate correttamente.</div><% } %>
      <div class="toolbar">
        <button onclick="showTab('content')">Contenuti</button>
        <button onclick="showTab('style')">Grafica</button>
        <button onclick="showTab('json')">JSON avanzato</button>
        <select class="admin-jump" onchange="jumpAdminSection(this.value); this.value='';">
          <option value="">Vai a una sezione...</option>
          <option value="Impostazioni contatti">Impostazioni contatti</option>
          <option value="Hero / Prima schermata">Hero / Prima schermata</option>
          <option value="Servizi">Servizi</option>
          <option value="BES e DSA">BES e DSA</option>
          <option value="Stimolazione cognitiva">Stimolazione cognitiva</option>
          <option value="Testo stimolazione cognitiva">Testo stimolazione cognitiva</option>
          <option value="Chi sono">Chi sono</option>
          <option value="Passaggi primo colloquio">Passaggi primo colloquio</option>
          <option value="Articoli">Articoli</option>
          <option value="Contatti">Contatti</option>
          <option value="Grafica globale">Grafica globale</option>
          <option value="Menu sito">Menu sito</option>
        </select>
        <form method="post" action="/admin/save" onsubmit="syncAndSave()">
          <input type="hidden" name="siteJson" id="siteJson">
          <button class="save">Salva tutto</button>
        </form>
      </div>
      <div class="workspace">
        <section class="editor">
          <div id="tab-content" class="tab active"></div>
          <div id="tab-style" class="tab"></div>
          <div id="tab-json" class="tab"><textarea id="jsonArea"></textarea></div>
        </section>
        <section class="preview">
          <iframe src="/preview"></iframe>
        </section>
      </div>
    </main>
  </div>
<script>
let site = <%- JSON.stringify(site) %>;
</script>
<script src="/js/admin.js"></script>
</body>
</html>
