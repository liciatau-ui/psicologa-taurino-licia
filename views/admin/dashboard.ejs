<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin visuale - Psicologa Taurino Licia</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@600;700;800&family=Montserrat:wght@300;400;500;600;700;800;900&family=Lora:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="visual-admin-body">
  <form method="post" action="/admin/save" id="saveForm" onsubmit="prepareSave(event)">
    <input type="hidden" name="siteJson" id="siteJson">
  </form>

  <div class="visual-admin">
    <aside class="admin-side">
      <div class="admin-brand-mini"><span>LT</span><div><b>Admin visuale</b><small>clicca sul sito e modifica</small></div></div>
      <button class="save-main" form="saveForm">Salva modifiche</button>
      <a class="side-link" href="/" target="_blank">Apri sito pubblico</a>
      <button class="side-link" type="button" onclick="selectGlobal()">Impostazioni generali</button>
      <button class="side-link" type="button" onclick="selectMenuManager()">Menu e ordine sezioni</button>
      <% if(saved){ %><div class="saved-pill">Salvato ✅</div><% } %>
      <p class="side-help">Suggerimento: clicca una scritta, una foto, un box, una sezione o una voce menu. A destra compaiono le impostazioni.</p>
      <form method="post" action="/admin/logout"><button class="logout-btn">Esci</button></form>
    </aside>

    <main class="visual-canvas-wrap">
      <div class="canvas-topbar">
        <strong>Anteprima modificabile</strong>
        <span id="selectedLabel">Nessun elemento selezionato</span>
        <button type="button" onclick="renderVisualSite()">Aggiorna</button>
      </div>
      <div id="visualSite" class="visual-site"></div>
    </main>

    <aside class="inspector">
      <div class="inspector-head">
        <h2>Impostazioni</h2>
        <p id="inspectorSub">Clicca un elemento del sito.</p>
      </div>
      <div id="inspectorContent" class="inspector-content empty-state">
        <p>Seleziona una scritta, immagine, box o sezione per modificarla.</p>
      </div>
    </aside>
  </div>

<script>let site = <%- JSON.stringify(site) %>;</script>
<script src="/js/admin.js"></script>
</body>
</html>
